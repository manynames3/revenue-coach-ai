# Database
DATABASE_URL=postgresql://revenuecoach:revenuecoach@localhost:5432/revenuecoach

# Z.AI / GLM 5.1
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.1

# True disables scoring real calls. Only the labeled synthetic sample is available.
MOCK_AI=true

# Workspace sessions (use Secure cookies and an HTTPS URL in production)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_HOURS=8
AUTO_CREATE_SCHEMA=false

# Background scoring limits
ANALYSIS_TIMEOUT_SECONDS=45
MAX_TRANSCRIPT_CHARACTERS=80000
DAILY_ANALYSIS_LIMIT=100

# Optional SES-verified sender for password recovery; never a frontend secret.
AUTH_EMAIL_FROM=

# Optional pilot price in USD. Omit to show "Scoped and quoted"; invoices are manual.
SUPPORT_EMAIL=

# AWS Settings (Required for Audio Upload & Transcribe)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=revenuecoach-audio
