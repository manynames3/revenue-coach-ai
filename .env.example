# Database
DATABASE_URL=postgresql://revenuecoach:revenuecoach@localhost:5432/revenuecoach

# Z.AI / GLM 5.1
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
